{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recipe",
  "description": "The shape of one video slot. Written by Recipe (code). Writer must not change it.",
  "type": "object",
  "required": ["id", "channel", "week", "slot", "theme", "opening", "primitives", "transitions", "rhythm", "hook_pattern", "fingerprint", "experiment"],
  "properties": {
    "id": {"type": "string"},
    "channel": {"enum": ["c1-automation", "c2-reach", "c3-studio"]},
    "week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "slot": {"type": "integer", "minimum": 1, "maximum": 7},
    "theme": {"enum": ["paper", "ink", "mono", "studio", "night"]},
    "opening": {"type": "string", "description": "Primitive id of the opener"},
    "primitives": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "transitions": {"type": "array", "items": {"type": "string"}},
    "rhythm": {"type": "string", "description": "TBD (owner: Navin): rhythm vocabulary"},
    "hook_pattern": {"enum": ["pile", "should-not", "question", "number", "confession", "myth", "before-after"]},
    "hero_metaphor": {"type": "string"},
    "fingerprint": {"type": "string"},
    "experiment": {"type": "boolean", "description": "true = part of the 30% experiments"}
  }
}
