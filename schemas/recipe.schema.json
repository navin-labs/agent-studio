{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recipe",
  "description": "The shape of one video slot. Written by Recipe (code). Writer must not change it.",
  "type": "object",
  "required": [
    "id",
    "channel",
    "week",
    "slot",
    "theme",
    "opening",
    "primitives",
    "transitions",
    "rhythm",
    "hook_pattern",
    "fingerprint",
    "experiment"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 80
    },
    "channel": {
      "enum": [
        "c1-automation",
        "c2-reach",
        "c3-studio"
      ]
    },
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$"
    },
    "slot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "theme": {
      "enum": [
        "paper",
        "ink",
        "mono",
        "studio",
        "night"
      ]
    },
    "opening": {
      "enum": [
        "word-stack-slam",
        "highlighter-swipe",
        "pile-drop",
        "counter-drop",
        "flow-build",
        "flow-run",
        "conveyor",
        "chat-pop",
        "stamp-hit",
        "host-hook",
        "ui-inbox",
        "ui-sheet",
        "ui-chat",
        "ui-diff",
        "host-payoff",
        "host-cta",
        "end-card"
      ],
      "description": "Primitive id of the opener"
    },
    "primitives": {
      "type": "array",
      "items": {
        "enum": [
          "word-stack-slam",
          "highlighter-swipe",
          "pile-drop",
          "counter-drop",
          "flow-build",
          "flow-run",
          "conveyor",
          "chat-pop",
          "stamp-hit",
          "host-hook",
          "ui-inbox",
          "ui-sheet",
          "ui-chat",
          "ui-diff",
          "host-payoff",
          "host-cta",
          "end-card"
        ]
      },
      "minItems": 3,
      "maxItems": 12
    },
    "transitions": {
      "type": "array",
      "items": {
        "enum": [
          "cut",
          "whip-pan",
          "ink-wipe",
          "pixel-wipe"
        ]
      }
    },
    "rhythm": {
      "type": "string",
      "description": "TBD (owner: Navin): rhythm vocabulary"
    },
    "hook_pattern": {
      "enum": [
        "pile",
        "should-not",
        "question",
        "number",
        "confession",
        "myth",
        "before-after"
      ]
    },
    "hero_metaphor": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "experiment": {
      "type": "boolean",
      "description": "true = part of the 30% experiments"
    }
  }
}
