{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ledger",
  "description": "One entry per platform variant of a video (studio/variant.ts); the latest line per (video, platform) wins. Dispatch only acts on status approved; approval needs a person, a time and the hash of the exact video approved.",
  "type": "object",
  "required": [
    "storyboard_id",
    "platform",
    "channel",
    "status",
    "updated_at"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "status": {
        "enum": [
          "approved",
          "dispatching",
          "dispatched",
          "published"
        ]
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "approved_by",
      "approved_at",
      "sha256"
    ]
  },
  "properties": {
    "storyboard_id": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "enum": [
        "youtube",
        "instagram",
        "facebook"
      ],
      "description": "one line per platform variant (studio/variant.ts)"
    },
    "channel": {
      "enum": [
        "c1-automation",
        "c2-reach",
        "c3-studio"
      ]
    },
    "status": {
      "enum": [
        "rendered",
        "qa-failed",
        "pending-approval",
        "approved",
        "rejected",
        "dispatching",
        "dispatched",
        "published"
      ]
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "post_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "style": {
      "type": "string",
      "pattern": "^c[0-9]-[a-z0-9-]+-v[0-9]+$",
      "description": "the style preset the approved video was rendered in"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the variant video that was approved; dispatch refuses if the file on disk is no longer that video (a render after approval needs a new approval)"
    },
    "approval": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "the approval link it came from (first 16 hex of its signature); a link is used once, so replaying it after a rejection is refused"
    }
  }
}
