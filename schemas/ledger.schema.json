{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ledger",
  "description": "One entry per video. Dispatch only acts on status approved; approval needs a person and a time.",
  "type": "object",
  "required": [
    "storyboard_id",
    "channel",
    "status",
    "updated_at"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "status": {
        "enum": [
          "approved",
          "dispatched",
          "published"
        ]
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "approved_by",
      "approved_at",
      "targets"
    ]
  },
  "properties": {
    "storyboard_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "c1-automation",
        "c2-reach",
        "c3-studio"
      ]
    },
    "status": {
      "enum": [
        "rendered",
        "qa-failed",
        "pending-approval",
        "approved",
        "rejected",
        "dispatched",
        "published"
      ]
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "instagram",
          "facebook",
          "youtube"
        ]
      }
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "post_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
