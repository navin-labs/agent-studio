{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "storyboard",
  "description": "Recipe plus words. Written by Writer (Forge), rendered by the engine Composer. Field names follow the engine (camelCase).",
  "type": "object",
  "required": [
    "format",
    "id",
    "channel",
    "theme",
    "hookPattern",
    "scenes",
    "caption",
    "hashtags",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "storyboard"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 80
    },
    "channel": {
      "enum": [
        "c1-automation",
        "c2-reach",
        "c3-studio"
      ]
    },
    "theme": {
      "enum": [
        "paper",
        "ink",
        "mono",
        "studio",
        "night",
        "archive",
        "night-signal",
        "archive-gold"
      ]
    },
    "host": {
      "enum": [
        "chiku",
        "bahi",
        "tikku"
      ],
      "description": "Host format: the channel mascot"
    },
    "captionStyle": {
      "enum": [
        "keywords",
        "karaoke"
      ]
    },
    "hookPattern": {
      "enum": [
        "pile",
        "should-not",
        "question",
        "number",
        "confession",
        "myth",
        "before-after"
      ]
    },
    "sfx": {
      "type": "boolean"
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "primitive",
          "params"
        ],
        "additionalProperties": false,
        "properties": {
          "primitive": {
            "enum": [
              "word-stack-slam",
              "highlighter-swipe",
              "pile-drop",
              "counter-drop",
              "flow-build",
              "flow-run",
              "conveyor",
              "chat-pop",
              "stamp-hit",
              "host-hook",
              "ui-inbox",
              "ui-sheet",
              "ui-chat",
              "ui-diff",
              "host-payoff",
              "host-cta",
              "end-card",
              "split-flap",
              "before-after-split",
              "phone-buzz",
              "maze-to-line",
              "zoom-dive"
            ]
          },
          "params": {
            "type": "object",
            "description": "Per primitive; fields and text limits are checked by the engine (specs.ts validateParams)"
          },
          "vo": {
            "type": "string",
            "minLength": 1,
            "description": "Caption and voice line; *accent* runs become the shot's cue frames"
          },
          "say": {
            "type": "string",
            "minLength": 1,
            "description": "Exact TTS text when pronunciation needs fixing"
          },
          "transition": {
            "enum": [
              "cut",
              "whip-pan",
              "ink-wipe",
              "pixel-wipe",
              "fold"
            ]
          },
          "captions": {
            "type": "boolean"
          }
        }
      }
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2200
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[a-z0-9]+$"
      },
      "minItems": 3,
      "maxItems": 5
    },
    "music": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "required": [
        "source",
        "idea_id",
        "recipe_id"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "format": "uri",
          "description": "The feed link the idea came from"
        },
        "idea_id": {
          "type": "string",
          "minLength": 1
        },
        "recipe_id": {
          "type": "string",
          "minLength": 1
        },
        "hero_metaphor": {
          "type": "string",
          "minLength": 1,
          "description": "The video's central image, checked by the 14-day novelty rule"
        },
        "title_b": {
          "type": "string",
          "minLength": 10,
          "maxLength": 100,
          "description": "Experiment arm B: an alternative YouTube title (arm A is caption line 1). Optional."
        },
        "thumb_b": {
          "type": "string",
          "minLength": 3,
          "maxLength": 60,
          "description": "Experiment arm B: an alternative thumbnail headline, *accent* allowed (arm A is the hook). Optional."
        },
        "year": {
          "type": "string",
          "pattern": "^[0-9]{3,4}$",
          "description": "the story's year, shown by the year-flap opener"
        }
      }
    },
    "style": {
      "type": "string",
      "pattern": "^c[0-9]-[a-z0-9-]+-v[0-9]+$",
      "description": "style preset id (styles/<id>.json); unset: the channel's style"
    }
  }
}
