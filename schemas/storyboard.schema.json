{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "storyboard",
  "description": "Recipe plus words. Written by Writer (Forge), rendered by the engine Composer. Field names follow the engine (camelCase).",
  "type": "object",
  "required": [
    "format",
    "id",
    "channel",
    "theme",
    "hookPattern",
    "scenes",
    "caption",
    "hashtags",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "storyboard"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 80
    },
    "voice": {
      "type": "object",
      "required": ["engine", "speed"],
      "description": "Only for a board with no channel (demos, tests): its own voice, the same shape as channel.json \"voice\". A channel board always speaks in its channel's voice."
    },
    "channel": {
      "enum": [
        "c1-automation",
        "c2-reach",
        "c3-studio"
      ]
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "A theme in engine/src/themes.ts (the engine rejects an unknown one); a film may add its own palette there"
    },
    "host": {
      "enum": [
        "chiku",
        "bahi",
        "tikku"
      ],
      "description": "Host format: the channel mascot"
    },
    "captionStyle": {
      "enum": [
        "keywords",
        "karaoke"
      ]
    },
    "hookPattern": {
      "enum": [
        "pile",
        "should-not",
        "question",
        "number",
        "confession",
        "myth",
        "before-after"
      ]
    },
    "sfx": {
      "type": "boolean"
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "primitive",
          "params"
        ],
        "additionalProperties": false,
        "properties": {
          "primitive": {
            "enum": [
              "word-stack-slam",
              "highlighter-swipe",
              "pile-drop",
              "counter-drop",
              "flow-build",
              "flow-run",
              "conveyor",
              "chat-pop",
              "stamp-hit",
              "host-hook",
              "ui-inbox",
              "ui-sheet",
              "ui-chat",
              "ui-diff",
              "host-payoff",
              "host-cta",
              "end-card",
              "split-flap",
              "before-after-split",
              "phone-buzz",
              "maze-to-line",
              "zoom-dive"
            ]
          },
          "params": {
            "type": "object",
            "description": "Per primitive; fields and text limits are checked by the engine (specs.ts validateParams)"
          },
          "vo": {
            "type": "string",
            "minLength": 1,
            "description": "Caption and voice line; *accent* runs become the shot's cue frames"
          },
          "voice": {
                "type": "object",
                "description": "How the line is said (the Writer): feel (emotion), pace (slow 0.9x, steady, quick 1.1x speed) and hold (seconds of silence after the line, before a reveal)",
                "required": ["feel"],
                "additionalProperties": false,
                "properties": {
                  "feel": {"enum": ["curious", "tense", "frustrated", "surprised", "warm", "wry", "urgent", "calm", "triumphant"]},
                  "pace": {"enum": ["slow", "steady", "quick"]},
                  "hold": {"type": "number", "minimum": 0, "maximum": 1.2}
                }
              },
              "say": {
            "type": "string",
            "minLength": 1,
            "description": "Exact TTS text when pronunciation needs fixing"
          },
          "transition": {
            "enum": [
              "cut",
              "whip-pan",
              "ink-wipe",
              "pixel-wipe",
              "fold"
            ]
          },
          "captions": {
            "type": "boolean"
          }
        }
      }
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2200
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[a-z0-9]+$"
      },
      "minItems": 3,
      "maxItems": 5
    },
    "music": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "required": [
        "source",
        "idea_id",
        "recipe_id"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "format": "uri",
          "description": "The feed link the idea came from"
        },
        "idea_id": {
          "type": "string",
          "minLength": 1
        },
        "recipe_id": {
          "type": "string",
          "minLength": 1
        },
        "hero_metaphor": {
          "type": "string",
          "minLength": 1,
          "description": "The video's central image, checked by the 14-day novelty rule"
        },
        "title_b": {
          "type": "string",
          "minLength": 10,
          "maxLength": 100,
          "description": "Experiment arm B: an alternative YouTube title (arm A is caption line 1). Optional."
        },
        "thumb_b": {
          "type": "string",
          "minLength": 3,
          "maxLength": 60,
          "description": "Experiment arm B: an alternative thumbnail headline, *accent* allowed (arm A is the hook). Optional."
        },
        "year": {
          "type": "string",
          "pattern": "^[0-9]{3,4}$",
          "description": "the story's year, shown by the year-flap opener"
        },
        "idea": {"type": "string", "minLength": 20, "description": "The film in one plain sentence, written before anything else (script first); no direction starts without it"},
        "hook_image": {"type": "string", "minLength": 12, "description": "The first frame, named concretely (who or what, doing what, where); the Director opens on it"},
        "payoff_image": {"type": "string", "minLength": 12, "description": "The closing picture that pays off the story; the Director ends on it"},
        "structure": {
          "enum": ["story", "essay", "teardown", "before-after", "myth-bust", "gag"],
          "description": "the story's shape; rotates across a channel's films (studio/styles.ts)"
        },
        "cta": {
          "enum": ["none", "question", "save", "comment-keyword", "follow-series"],
          "description": "the one call to action; rotates across a channel's films"
        },
        "series": {
          "type": "object",
          "required": ["name", "part"],
          "properties": {"name": {"type": "string"}, "part": {"type": "integer", "minimum": 1}, "of": {"type": "integer", "minimum": 1}},
          "description": "a numbered series keeps one visual world across its parts; the idea changes each part"
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "novelty",
              "open-loop",
              "reveal",
              "contrast",
              "proof",
              "stakes",
              "urgency",
              "number",
              "second-person",
              "pattern-interrupt",
              "callback",
              "loop",
              "failed-attempt"
            ]
          },
          "description": "The storytelling devices this script uses (docs/CREATIVE_BIBLE.md section 13; studio/script.ts checks them)"
        },
        "proof": {
          "type": "object",
          "required": [
            "fact",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "fact": {
              "type": "string",
              "minLength": 3,
              "maxLength": 120
            },
            "source": {
              "type": "string",
              "format": "uri"
            }
          },
          "description": "The one hard, specific fact shown on screen, with its source"
        }
      }
    },
    "style": {
      "type": "string",
      "pattern": "^c[0-9]-[a-z0-9-]+-v[0-9]+$",
      "description": "style preset id (styles/<id>.json); unset: the channel's style"
    },
    "film": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "An authored film (engine/src/films/index.ts) that renders this board instead of the primitive shots; written by the Director"
    },
    "brief": {
      "type": "object",
      "description": "The creative brief (engine/src/films/brief.ts): the contract between the story and its film",
      "required": [
        "story_core",
        "emotion",
        "hook",
        "visual_question",
        "metaphor",
        "world",
        "camera",
        "motion",
        "typography",
        "material",
        "transitions",
        "sound",
        "payoff",
        "music",
        "coords"
      ],
      "additionalProperties": false,
      "properties": {
        "story_core": {
          "type": "string",
          "minLength": 8
        },
        "emotion": {
          "type": "string",
          "minLength": 8
        },
        "hook": {
          "type": "string",
          "minLength": 8
        },
        "visual_question": {
          "type": "string",
          "minLength": 8
        },
        "metaphor": {
          "type": "string",
          "minLength": 8
        },
        "world": {
          "type": "string",
          "minLength": 8
        },
        "camera": {
          "type": "string",
          "minLength": 8
        },
        "motion": {
          "type": "string",
          "minLength": 8
        },
        "typography": {
          "type": "string",
          "minLength": 8
        },
        "material": {
          "type": "string",
          "minLength": 8
        },
        "transitions": {
          "type": "string",
          "minLength": 8
        },
        "sound": {
          "type": "string",
          "minLength": 8
        },
        "payoff": {
          "type": "string",
          "minLength": 8
        },
        "music": {
          "type": "object",
          "required": [
            "caption",
            "bpm"
          ],
          "additionalProperties": false,
          "properties": {
            "caption": {
              "type": "string",
              "minLength": 12
            },
            "bpm": {
              "type": "number",
              "minimum": 40,
              "maximum": 200
            },
            "key": {
              "type": "string"
            },
            "seed": {
              "type": "number"
            }
          }
        },
        "coords": {
          "type": "object",
          "required": [
            "luminance",
            "temperature",
            "rendering",
            "space",
            "camera",
            "motion",
            "texture",
            "type",
            "hook",
            "sound"
          ],
          "additionalProperties": false,
          "properties": {
            "luminance": {
              "type": "string",
              "enum": [
                "dark",
                "mid",
                "bright"
              ]
            },
            "temperature": {
              "type": "string",
              "enum": [
                "warm",
                "neutral",
                "cool",
                "mono"
              ]
            },
            "rendering": {
              "type": "string",
              "enum": [
                "vector-illustration",
                "painted",
                "sketch",
                "engraving",
                "typographic",
                "geometric",
                "diagram",
                "paper-craft",
                "collage",
                "procedural",
                "photographic"
              ]
            },
            "space": {
              "type": "string",
              "enum": [
                "flat",
                "layered",
                "world-space",
                "macro",
                "isometric",
                "single-object"
              ]
            },
            "camera": {
              "type": "string",
              "enum": [
                "locked",
                "push-pull",
                "tracking",
                "scroll",
                "handheld",
                "cut-based",
                "orbit"
              ]
            },
            "motion": {
              "type": "string",
              "enum": [
                "physical",
                "elastic",
                "mechanical",
                "fluid",
                "stepped",
                "typographic",
                "organic"
              ]
            },
            "texture": {
              "type": "string",
              "enum": [
                "clean",
                "grain",
                "paper",
                "ink",
                "film",
                "halftone",
                "watercolour"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "serif-editorial",
                "grotesk",
                "mono-technical",
                "typewriter",
                "display",
                "handwritten",
                "condensed",
                "minimal"
              ]
            },
            "hook": {
              "type": "string",
              "enum": [
                "macro",
                "scale",
                "contradiction",
                "transformation",
                "misdirection",
                "mystery",
                "silence",
                "typographic",
                "physical-interaction",
                "impossible",
                "countdown"
              ]
            },
            "sound": {
              "type": "string",
              "enum": [
                "foley-led",
                "music-led",
                "silence-led",
                "tonal",
                "rhythmic"
              ]
            }
          }
        }
      }
    },
    "direction": {
      "type": "object",
      "description": "A format film (\"film\": \"<format id>\"): the chosen style, one shot per voice line, the music (engine/src/fx/direction.ts; validated by studio/direction.ts); written by the Director",
      "required": ["style", "shots"],
      "properties": {
        "style": {"type": "object", "required": ["format", "look", "suit"]},
        "music": {"type": "object", "required": ["caption", "bpm"]},
        "footage": {"type": "string"},
        "shots": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "scene": {
      "type": "object",
      "description": "An effect-driven film (\"film\": \"scene\"): shots of engine/src/fx effects placed on the voice beats (engine/src/fx/scene.ts); written by the Director",
      "required": [
        "shots"
      ],
      "additionalProperties": false,
      "properties": {
        "look": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "beat",
              "fx"
            ],
            "additionalProperties": false,
            "properties": {
              "beat": {
                "type": "integer",
                "minimum": 0
              },
              "from": {
                "type": "number",
                "minimum": 0
              },
              "to": {
                "type": "number",
                "minimum": 0
              },
              "fx": {
                "type": "string",
                "pattern": "^[a-z0-9:-]+$"
              },
              "props": {
                "type": "object"
              },
              "camera": {
                "type": "object",
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "to": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "focal": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
