{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "channel",
  "description": "Per-channel config: role, KPI, CTA, themes, cadence, publishers, host.",
  "type": "object",
  "required": [
    "id",
    "role",
    "audience",
    "kpi",
    "cta",
    "cadence",
    "publishers"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "enum": [
        "c1-automation",
        "c2-reach",
        "c3-studio"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "kpi": {
      "type": "object",
      "required": [
        "metric",
        "target",
        "numerator",
        "denominator"
      ],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "numerator": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "reach",
              "views",
              "avg_watch_s",
              "sends",
              "saves",
              "follows",
              "profile_visits",
              "dms",
              "enquiries"
            ]
          },
          "description": "metrics fields summed on top"
        },
        "denominator": {
          "enum": [
            "reach",
            "views",
            "avg_watch_s",
            "sends",
            "saves",
            "follows",
            "profile_visits",
            "dms",
            "enquiries"
          ],
          "description": "metrics field below the line"
        }
      }
    },
    "cta": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text",
          "share"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "share": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "content_mix": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "paper",
          "ink",
          "mono",
          "studio",
          "night",
          "archive",
          "night-signal",
          "archive-gold"
        ]
      },
      "description": "Only for a channel without a style preset (a styled channel takes its theme from the preset)."
    },
    "cadence": {
      "type": "object",
      "required": [
        "posts_per_week"
      ],
      "additionalProperties": false,
      "properties": {
        "posts_per_week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14
        }
      }
    },
    "publishers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "platform",
          "handle",
          "via"
        ],
        "additionalProperties": false,
        "properties": {
          "platform": {
            "enum": [
              "instagram",
              "facebook",
              "youtube"
            ]
          },
          "handle": {
            "type": "string",
            "minLength": 1,
            "description": "@name; \"pending_...\" while the username cannot be claimed yet: the channel renders, and nothing is sent to that platform, except Facebook with a page_id, which posts to the page by its ID"
          },
          "via": {
            "enum": [
              "forge-queue",
              "n8n"
            ],
            "description": "how this platform is reached: n8n (YouTube, that channel's own upload workflow) or forge-queue (Instagram, Facebook: queue/<channel>/<platform>/); must match the style preset's destination"
          },
          "page_id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Facebook only: the page ID (Forge posts to the page by ID)."
          },
          "webhook": {
            "type": "string",
            "pattern": "^http://localhost:5678/webhook/agent-studio-youtube-c[0-9]-[a-z0-9-]+$",
            "description": "YouTube: this channel's own n8n upload webhook, exactly http://localhost:5678/webhook/agent-studio-youtube-<channel id> (one workflow per YouTube account). Required to dispatch to YouTube: there is no shared default, so one channel's video can never reach another channel's workflow."
          }
        }
      }
    },
    "launch_gate": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "enum": [
        "chiku",
        "bahi",
        "tikku"
      ],
      "description": "the channel mascot for host-format videos"
    },
    "live": {
      "type": "boolean",
      "description": "Go-live switch. Dispatch sends nothing for a channel until this is true (Navin sets it at production setup)."
    },
    "feeds": {
      "type": "array",
      "description": "Where this channel's ideas come from. n8n fetches each, the Mac turns items into ideas (studio/feed.ts).",
      "items": {
        "type": "object",
        "required": [
          "source",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "enum": [
              "reddit",
              "google-trends",
              "youtube",
              "ig-question"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "required": [
        "engine",
        "speed"
      ],
      "additionalProperties": false,
      "description": "The channel voice: a local open-source engine with a built-in voice (no cloning, no paid API). engine/README.md \"Voice\".",
      "properties": {
        "engine": {
          "enum": [
            "kokoro",
            "parler",
            "chatterbox"
          ]
        },
        "voice": {
          "type": "string",
          "minLength": 1,
          "description": "Built-in voice id (Kokoro), speaker name (Parler); omitted for Chatterbox (its default voice)"
        },
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "pronounce": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Word -> what the engine reads instead, per channel (Kokoro phonemes: \"[Tally](/tˈɑli/)\")"
        }
      }
    },
    "style": {
      "type": "string",
      "pattern": "^c[0-9]-[a-z0-9-]+-v[0-9]+$",
      "description": "the channel's style preset (styles/<id>.json); change this one setting to switch or roll back a style"
    }
  }
}
