{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "channel",
  "description": "Per-channel config: role, KPI, CTA, themes, cadence, publishers, host.",
  "type": "object",
  "required": [
    "id",
    "role",
    "audience",
    "kpi",
    "cta",
    "themes",
    "cadence",
    "publishers"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "enum": [
        "c1-automation",
        "c2-reach",
        "c3-studio"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "kpi": {
      "type": "object",
      "required": [
        "metric",
        "target",
        "numerator",
        "denominator"
      ],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "numerator": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "reach",
              "views",
              "avg_watch_s",
              "sends",
              "saves",
              "follows",
              "profile_visits",
              "dms",
              "enquiries"
            ]
          },
          "description": "metrics fields summed on top"
        },
        "denominator": {
          "enum": [
            "reach",
            "views",
            "avg_watch_s",
            "sends",
            "saves",
            "follows",
            "profile_visits",
            "dms",
            "enquiries"
          ],
          "description": "metrics field below the line"
        }
      }
    },
    "cta": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text",
          "share"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "share": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "content_mix": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "paper",
          "ink",
          "mono",
          "studio",
          "night"
        ]
      }
    },
    "cadence": {
      "type": "object",
      "required": [
        "posts_per_week"
      ],
      "additionalProperties": false,
      "properties": {
        "posts_per_week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14
        }
      }
    },
    "publishers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "platform",
          "handle",
          "via"
        ],
        "additionalProperties": false,
        "properties": {
          "platform": {
            "enum": [
              "instagram",
              "facebook",
              "youtube"
            ]
          },
          "handle": {
            "type": "string",
            "minLength": 1
          },
          "via": {
            "enum": [
              "forge-queue",
              "n8n"
            ]
          },
          "webhook": {
            "type": "string",
            "pattern": "^http://localhost:5678/webhook/[a-z0-9-]+$",
            "description": "YouTube only: this channel's n8n upload webhook (one per YouTube account). Default: YOUTUBE_WEBHOOK_URL."
          }
        }
      }
    },
    "launch_gate": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "enum": [
        "chiku",
        "bahi",
        "tikku"
      ],
      "description": "the channel mascot for host-format videos"
    },
    "live": {
      "type": "boolean",
      "description": "Go-live switch. Dispatch sends nothing for a channel until this is true (Navin sets it at production setup)."
    }
  }
}
