{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fingerprint",
  "description": "What novelty rules compare against. One per published or approved video.",
  "type": "object",
  "required": ["id", "channel", "date", "topic_text", "primitives", "opening", "theme", "hook_pattern"],
  "properties": {
    "id": {"type": "string"},
    "channel": {"enum": ["c1-automation", "c2-reach", "c3-studio"]},
    "date": {"type": "string", "format": "date"},
    "topic_text": {"type": "string"},
    "primitives": {"type": "array", "items": {"type": "string"}},
    "opening": {"type": "string"},
    "hero_metaphor": {"type": "string"},
    "theme": {"enum": ["paper", "ink", "mono", "studio", "night"]},
    "hook_pattern": {"enum": ["pile", "should-not", "question", "number", "confession", "myth", "before-after"]},
    "caption_opener": {"type": "string"},
    "hash": {"type": "string"}
  }
}
