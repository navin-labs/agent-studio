{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "idea",
  "description": "One candidate topic from a real feed. Written by Feed (n8n).",
  "type": "object",
  "required": ["id", "channel", "title", "source_url", "source", "date"],
  "properties": {
    "id": {"type": "string"},
    "channel": {"enum": ["c1-automation", "c2-reach", "c3-studio"]},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "source": {"enum": ["reddit", "google-trends", "youtube", "ig-question"]},
    "source_url": {"type": "string", "format": "uri"},
    "date": {"type": "string", "format": "date"}
  }
}
