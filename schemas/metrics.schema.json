{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metrics",
  "description": "Post performance at 24h and 7d. Instagram/Facebook from Forge (inbox/metrics), YouTube views from n8n; every row checked by studio/metrics.ts.",
  "type": "object",
  "required": [
    "storyboard_id",
    "channel",
    "platform",
    "window",
    "reach"
  ],
  "additionalProperties": false,
  "properties": {
    "storyboard_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "c1-automation",
        "c2-reach",
        "c3-studio"
      ]
    },
    "platform": {
      "enum": [
        "instagram",
        "facebook",
        "youtube"
      ]
    },
    "window": {
      "enum": [
        "24h",
        "7d"
      ]
    },
    "reach": {
      "type": "integer",
      "minimum": 0
    },
    "views": {
      "type": "integer",
      "minimum": 0
    },
    "avg_watch_s": {
      "type": "number",
      "minimum": 0
    },
    "sends": {
      "type": "integer",
      "minimum": 0
    },
    "saves": {
      "type": "integer",
      "minimum": 0
    },
    "follows": {
      "type": "integer",
      "minimum": 0
    },
    "profile_visits": {
      "type": "integer",
      "minimum": 0
    },
    "dms": {
      "type": "integer",
      "minimum": 0
    },
    "enquiries": {
      "type": "integer",
      "minimum": 0
    },
    "retention": {
      "type": "array",
      "minItems": 20,
      "maxItems": 100,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      },
      "description": "YouTube only: audienceWatchRatio at evenly spaced points of the video (YouTube Analytics, elapsedVideoTimeRatio 0.01..1.00). Learn maps it onto the scenes in render.json."
    }
  }
}
