# agent-studio/.env: copy this file to .env and fill it in. Never commit .env; never paste its values anywhere.
# Every name the studio reads (studio/*.ts). Empty values are placeholders, not defaults.

# Approvals: signed links and Telegram taps are verified with this secret (16+ random characters)
APPROVAL_SECRET=
# The n8n approval webhook the weekly page links to, e.g. http://localhost:5678/webhook/agent-studio-approve
APPROVAL_WEBHOOK_URL=

# Telegram bot: approvals, alerts and "agent-studio needs you" go to this one private chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dispatch stays a dry run unless this is on AND the command has --live (the last DISPATCH_LIVE line wins)
DISPATCH_LIVE=off

# Title/thumbnail experiments change live YouTube videos: off unless on
EXPERIMENTS=off

# Optional: the approve receiver's port (default 5680); state and recipes folders (default: this repo's state/ and recipes/)
# APPROVE_PORT=5680
# STUDIO_STATE=
# STUDIO_RECIPES=
# N8N_WEBHOOK_BASE=http://localhost:5678/webhook   (packaging experiments: base of agent-studio-packaging-<channel>)

# YouTube uploads go to each channel's own n8n webhook, set in channels/<id>/channel.json (no variable here on purpose).
