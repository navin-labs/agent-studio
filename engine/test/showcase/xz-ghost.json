  "scenes": [
    {
      "primitive": "intertitle",
      "params": {
        "text": "Half a second"
      },
      "vo": "Half a *second* of lag exposed a backdoor in Linux."
    },
    {
      "primitive": "intertitle",
      "params": {
        "text": "0.3 s to 0.8 s"
      },
      "vo": "SSH logins slowed from 0.3 to *0.8* seconds. Most engineers would blame the network."
    },
    {
      "primitive": "intertitle",
      "params": {
        "text": "liblzma"
      },
      "vo": "Andres Freund traced sshd *instead*. The trail led into *liblzma*."
    },
    {
      "primitive": "intertitle",
      "params": {
        "text": "Git and tar.gz"
      },
      "vo": "The trigger hid in the *5.6.0* release tarball. It was never in Git."
    },
    {
      "primitive": "intertitle",
      "params": {
        "text": "Jia Tan"
      },
      "vo": "How did it get there? A maintainer called *Jia Tan* spent two years earning trust."
    },
    {
      "primitive": "intertitle",
      "params": {
        "text": "SSH"
      },
      "vo": "The payload sat in *test files*, disguised as broken archives. It hijacked a function SSH uses to check keys."
    },
    {
      "primitive": "intertitle",
      "params": {
        "text": "Two years undone"
      },
      "vo": "It was already running on Debian unstable. Half a second of *lag* ended a two-year operation."
    },
    {
      "primitive": "end-card",
      "params": {
        "text": "Follow",
        "sub": "Evidence films, made in code."
      }
    }
