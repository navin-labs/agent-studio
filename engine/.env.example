# engine/.env: copy this file to .env. Never commit .env; never paste its values anywhere.
# Every name the engine reads (scripts/*.mjs). Empty values are placeholders, not defaults.

# Voiceover: on renders each line with the channel's own local voice (channels/<id>/channel.json "voice"; setup: README "Voice").
# Anything else renders silent with text timing (fine for previews; QA fails a voiced channel's silent render).
VOICE=off

# Optional paid voice APIs, used only for a board whose channel has no local voice. Force one with TTS_PROVIDER.
# TTS_PROVIDER=openai          (openai | elevenlabs | none)
OPENAI_API_KEY=
# OPENAI_TTS_VOICE=ash
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_INSTRUCTIONS=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional: where the watcher copies finished renders (default: Google Drive for desktop "My Drive/Reel Engine", else iCloud Drive)
# RENDER_COPY_DIR=
# Optional: the end-card handle for a preview render of a channel that has no handle yet
# PREVIEW_HANDLE=
# Optional: a Chrome/Chromium binary for Remotion instead of its own download
# REMOTION_BROWSER_EXECUTABLE=
