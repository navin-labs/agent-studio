# Option 0: YOUR cloned voice (local, free, Chatterbox MIT licence). Wins over the options below when the file exists.
# Setup once: see README "Your cloned voice".
# CLONE_VOICE=voice/navin.wav

# Copy this file to .env and fill in ONE voice provider.
# No key = the reel renders silent with text timing (fine for previews).

# Option A: Sarvam (Indian English voices, recommended)
SARVAM_API_KEY=
# Male: shubh, aditya, rahul, rohan, amit, kabir, varun, anand. Female: priya, ritu, neha, kavya, simran, shreya
SARVAM_SPEAKER=shubh
# Speed 0.5 to 2.0. 1.1 = slightly brisk, good for reels
SARVAM_PACE=1.1
# SARVAM_MODEL=bulbul:v3

# Option B: OpenAI
OPENAI_API_KEY=
OPENAI_TTS_VOICE=ash
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_INSTRUCTIONS=Voice: a friendly, confident Indian English business consultant...

# Option C: ElevenLabs (most natural; pick an Indian English voice in their Voice Library and paste its ID)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Force a provider if several are set: chatterbox | sarvam | openai | elevenlabs | none
# TTS_PROVIDER=openai

# Voiceover is parked. Set VOICE=on to bring it back (uses CLONE_VOICE or a TTS key).
VOICE=off
