{
  "name": "reel-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "theautomationguy.navin content engine: story JSON in, reel MP4 out.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "make": "node scripts/make.mjs",
    "vo": "node scripts/make.mjs --vo-only",
    "watch": "node scripts/watch.mjs",
    "watch:install": "node scripts/watch.mjs --install",
    "gate:themes": "node scripts/theme-gate.ts",
    "primitives": "node scripts/primitives.mjs",
    "stress": "node scripts/make.mjs test/stress-ui.json",
    "typecheck": "tsc",
    "schemas": "node ../schemas/validate.ts",
    "check": "tsc && node scripts/theme-gate.ts > /dev/null && node src/composer/textcheck.ts && node ../schemas/validate.ts > /dev/null && node ../studio/recipe.test.ts && node ../studio/qa.test.ts && node ../studio/approval.test.ts && node ../studio/dispatch.test.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.527",
    "@remotion/cli": "4.0.527",
    "@remotion/fonts": "^4.0.527",
    "@remotion/media-parser": "4.0.527",
    "@remotion/media-utils": "4.0.527",
    "@remotion/motion-blur": "4.0.527",
    "@remotion/noise": "4.0.527",
    "@remotion/paths": "4.0.527",
    "@remotion/renderer": "4.0.527",
    "lucide-react": "1.47.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.527"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "typescript": "7.0.2"
  }
}
