{
  "id": "agStudioPack2",
  "name": "agent-studio: YouTube packaging (C2 Backstory)",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "nodes": [
    {
      "name": "Packaging job",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "agent-studio-packaging-c2-reach",
      "parameters": {
        "httpMethod": "POST",
        "path": "agent-studio-packaging-c2-reach",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "name": "Ask the Mac",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// The Mac says yes only if its experiment step wants exactly this title on this video now (studio/experiment.ts).\nconst item = $input.first();\nconst job = JSON.parse(item.json.body.job);\nlet approved = false;\ntry {\n  await this.helpers.httpRequest({ url: 'http://host.docker.internal:5680/packaging-check', qs: { id: job.storyboard_id, channel: 'c2-reach', video_id: job.video_id, title: job.title } });\n  approved = true;\n} catch (e) {\n  approved = false;\n}\nreturn [{ json: { ...job, approved }, binary: item.binary?.thumbnail ? { thumbnail: item.binary.thumbnail } : {} }];"
      }
    },
    {
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "approved",
              "leftValue": "={{ $json.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Set thumbnail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -100
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "=https://www.googleapis.com/upload/youtube/v3/thumbnails/set?videoId={{ $json.video_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "thumbnail",
        "options": {}
      },
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "XFDCox9vmhXJenuh",
          "name": "YouTube C2 Backstory"
        }
      }
    },
    {
      "name": "Update title",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        960,
        -100
      ],
      "parameters": {
        "resource": "video",
        "operation": "update",
        "videoId": "={{ $('Ask the Mac').item.json.video_id }}",
        "title": "={{ $('Ask the Mac').item.json.title }}",
        "regionCode": "IN",
        "categoryId": "={{ $('Ask the Mac').item.json.category_id }}",
        "updateFields": {
          "description": "={{ $('Ask the Mac').item.json.description }}",
          "tags": "={{ $('Ask the Mac').item.json.tags.join(',') }}"
        }
      },
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "XFDCox9vmhXJenuh",
          "name": "YouTube C2 Backstory"
        }
      }
    },
    {
      "name": "Applied",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        -100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ applied: true }) }}",
        "options": {}
      }
    },
    {
      "name": "Refused",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ applied: false, reason: 'not an experiment step due now' }) }}",
        "options": {
          "responseCode": 403
        }
      }
    }
  ],
  "connections": {
    "Packaging job": {
      "main": [
        [
          {
            "node": "Ask the Mac",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask the Mac": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "Set thumbnail",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Refused",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set thumbnail": {
      "main": [
        [
          {
            "node": "Update title",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update title": {
      "main": [
        [
          {
            "node": "Applied",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
